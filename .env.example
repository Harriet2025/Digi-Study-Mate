# Copy to .env.local and fill in. All keys are server-only; never expose them to the browser.

# Supabase (Project Settings > API Keys)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq: all AI text (scripts, answers, defense questions/grading) and Whisper transcription.
# From https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# Optional overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ElevenLabs: Alex & Sam voices. From https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional: parallel TTS requests (free plan allows 2)
# TTS_CONCURRENCY=2
# Optional: override voices
# ELEVENLABS_VOICE_ALEX=
# ELEVENLABS_VOICE_SAM=
