# Copy to .env.local and fill in. Both the Next.js app and the Python backend read this file.
# All keys are server-only; never expose them to the browser.

# MySQL (the database is created by `npm run db:init`)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=study_mate

# Groq: all AI text (scripts, answers, defense questions/grading) and Whisper transcription.
# From https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ElevenLabs: Alex & Sam voices. From https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# TTS_CONCURRENCY=2
# ELEVENLABS_VOICE_ALEX=
# ELEVENLABS_VOICE_SAM=

# Where the Next.js server reaches the Python API (default shown)
# BACKEND_URL=http://127.0.0.1:8010
# Your Groq plan's tokens-per-minute limit (free tier 8000; 0 = no limit)
# GROQ_TPM_LIMIT=8000

# Hosting: a full MySQL URL instead of the MYSQL_* settings (e.g. Railway's MYSQL_URL). See DEPLOY.md.
# DATABASE_URL=mysql://user:password@host:3306/railway

# Accounts. APP_URL is the website's public address (http://localhost:3000 locally, your Vercel URL when hosted).
# APP_URL=http://localhost:3000
# "Continue with Google": create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials with the redirect URI  <APP_URL>/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
