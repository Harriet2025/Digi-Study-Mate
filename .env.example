# Server-only. Never expose the service role key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. From https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Text-to-speech: "elevenlabs" (default) or "openai"
TTS_PROVIDER=elevenlabs
# From https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Needed for "Interrupt & Ask" (Whisper transcription), and for TTS if TTS_PROVIDER=openai.
# From https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional: parallel TTS requests (ElevenLabs free plan allows 2)
# TTS_CONCURRENCY=2
# Optional: override voices
# ELEVENLABS_VOICE_ALEX=
# ELEVENLABS_VOICE_SAM=
